# Copy this file to .env and fill in your values

# Network interface (run: ip link show — to find yours)
SFW_INTERFACE=enp0s8

# Firebase (leave blank if not using cloud sync)
FIREBASE_CREDS=/path/to/serviceAccountKey.json
FIREBASE_DB_URL=https://your-project-default-rtdb.region.firebasedatabase.app

# Unique ID for this machine in Firebase peer sync
SFW_CLIENT_ID=my-sfw-node-1
